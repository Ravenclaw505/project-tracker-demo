# Copy to .env.local for development, and set the same four keys in Vercel
# (Project → Settings → Environment Variables) for the deployment.
#
# .env.local is git-ignored and must never be committed.

# Neon connection string (Neon dashboard → Connection Details → pooled).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Signs the session cookie. Use a long random value and a DIFFERENT one in
# production. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it signs everyone out.
SESSION_SECRET=replace-with-a-long-random-string

# The founding head — approved automatically when this address registers, and
# whoever matches it is upgraded to head on their next request.
HEAD_EMAIL=sadman.anwar@pathao.com

# Registration is limited to this email domain.
ALLOWED_EMAIL_DOMAIN=pathao.com
